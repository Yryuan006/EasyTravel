# Copy to .env only when the dedicated local test database is prepared.
# Never use a production or shared database. Scripts do not print the DSN.
EASYTRAVEL_TEST_DATABASE_URL=postgresql://easytravel_env00:REPLACE_LOCALLY@127.0.0.1:55432/easytravel_env00_test
EASYTRAVEL_MODEL_MODE=mock
LANGGRAPH_STRICT_MSGPACK=true
# No model API key is needed for ENV-00.

# Formal M0-01 HTTP app: required; only local and test are supported.
# This app does not read the ENV-00 database URL or load .env automatically.
EASYTRAVEL_APP_ENVIRONMENT=local

# M1-01: business routes are disabled unless explicitly enabled.
EASYTRAVEL_APP_LOCAL_BUSINESS_ENABLED=false
# Generate a NEW ignored local file; no token belongs in this example or VITE_*.
# python scripts/prepare_m101_local_identity.py --env-file .local/my-identity.env --actors local_a local_b
# Optional JSON arrays, validated to contain explicit loopback hosts/origins only:
# EASYTRAVEL_APP_LOCAL_ALLOWED_HOSTS='["127.0.0.1:8000"]'
# EASYTRAVEL_APP_LOCAL_ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://127.0.0.1:8000"]'

# M0-02 persistence: explicit, independent database configuration; never auto-loaded.
# Provision a fresh local test database with scripts/prepare_m002_test_db.py.
# Store its generated URL in an ignored .local/*.env file, never use ENV-00 here.
# EASYTRAVEL_DATABASE_URL=postgresql://ROLE:PASSWORD@127.0.0.1:55432/DEDICATED_DATABASE
# Upgrade explicitly: python -m easytravel.backend.infrastructure.migrate
