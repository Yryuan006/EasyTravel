      "timezone": {
        "const": "Asia/Shanghai",
        "default": "Asia/Shanghai",
        "title": "Timezone",
        "type": "string"
      },
      "source": {
        "$ref": "#/$defs/OpeningSource"
      },
      "weekly": {
        "items": {
