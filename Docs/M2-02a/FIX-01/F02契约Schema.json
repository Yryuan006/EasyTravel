            "$ref": "#/$defs/DayOpening"
          }
        },
        "required": [
          "weekday",
          "schedule"
        ],
        "title": "WeeklyOpening",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "opening-facts-v1",
        "default": "opening-facts-v1",
        "title": "Schema Version",
        "type": "string"
      },
      "fact_id": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Fact Id",
        "type": "string"
      },
      "resource": {
        "$ref": "#/$defs/ResourceRef"
      },
      "entrance_id": {
        "anyOf": [
          {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          {
            "type": "null"
          }
