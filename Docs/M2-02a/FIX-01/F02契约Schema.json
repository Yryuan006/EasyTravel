          "provider": {
            "const": "synthetic_opening_fixture",
            "default": "synthetic_opening_fixture",
            "title": "Provider",
            "type": "string"
          },
          "environment": {
            "const": "synthetic",
            "default": "synthetic",
            "title": "Environment",
            "type": "string"
          },
          "source_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
