        "type": "string"
      },
      "action": {
        "enum": [
          "none",
          "revise_activity",
          "obtain_facts",
          "replace_or_obtain_facts"
        ],
        "title": "Action",
        "type": "string"
      },
      "rule_version": {
        "const": "F02-synthetic-v1-fix01",
        "default": "F02-synthetic-v1-fix01",
        "title": "Rule Version",
        "type": "string"
      }
