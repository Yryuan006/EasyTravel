            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Provider Resource Id",
            "type": "string"
          },
          "city": {
            "maxLength": 200,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "district": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District"
