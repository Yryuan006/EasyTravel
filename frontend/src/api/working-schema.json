{
  "WorkingDraft": {
    "properties": {
      "trip_id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Trip Id"
      },
      "owner_id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Owner Id"
      },
      "revision": {
        "type": "integer",
        "minimum": 1.0,
        "title": "Revision"
      },
      "requirements": {
        "$ref": "#/components/schemas/TripRequirements"
      },
      "payload": {
        "$ref": "#/components/schemas/PlanDraftOutput"
      },
      "item_confirmations": {
        "items": {
          "$ref": "#/components/schemas/ItemConfirmation"
        },
        "type": "array",
        "title": "Item Confirmations"
      },
      "latest_confirmed_version_id": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Latest Confirmed Version Id"
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "trip_id",
      "owner_id",
      "revision",
      "requirements",
      "payload",
      "item_confirmations",
      "latest_confirmed_version_id"
    ],
    "title": "WorkingDraft"
  },
  "TripRequirements": {
    "properties": {
      "destination": {
        "type": "string",
        "maxLength": 500,
        "minLength": 1,
        "title": "Destination"
      },
      "start_date": {
        "type": "string",
        "format": "date",
        "title": "Start Date"
      },
      "end_date": {
        "type": "string",
        "format": "date",
        "title": "End Date"
      },
      "timezone": {
        "type": "string",
        "const": "Asia/Shanghai",
        "title": "Timezone"
      },
      "currency": {
        "type": "string",
        "const": "CNY",
        "title": "Currency"
      },
      "hard_limit_cents": {
        "type": "integer",
        "maximum": 1000000000000.0,
        "minimum": 0.0,
        "title": "Hard Limit Cents"
      },
      "requirements_revision": {
        "type": "integer",
        "minimum": 1.0,
        "title": "Requirements Revision"
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "destination",
      "start_date",
      "end_date",
      "timezone",
      "currency",
      "hard_limit_cents",
      "requirements_revision"
    ],
    "title": "TripRequirements"
  },
  "PlanDraftOutput": {
    "properties": {
      "items": {
        "items": {
          "$ref": "#/components/schemas/PlanItem"
        },
        "type": "array",
        "maxItems": 100,
        "minItems": 1,
        "title": "Items"
      },
      "costs": {
        "items": {
          "$ref": "#/components/schemas/CostLine"
        },
        "type": "array",
        "maxItems": 300,
        "minItems": 1,
        "title": "Costs"
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "items",
      "costs"
    ],
    "title": "PlanDraftOutput"
  },
  "PlanItem": {
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Id"
      },
      "kind": {
        "type": "string",
        "enum": [
          "hotel",
          "activity"
        ],
        "title": "Kind"
      },
      "resource_id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Resource Id"
      },
      "title": {
        "type": "string",
        "maxLength": 500,
        "minLength": 1,
        "title": "Title"
      },
      "start": {
        "type": "string",
        "format": "date-time",
        "title": "Start"
      },
      "end": {
        "type": "string",
        "format": "date-time",
        "title": "End"
      },
      "room_type": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "title": "Room Type"
      },
      "check_in": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ],
        "title": "Check In"
      },
      "check_out": {
        "anyOf": [
          {
            "type": "string",
            "format": "date"
          },
          {
            "type": "null"
          }
        ],
        "title": "Check Out"
      },
      "rooms": {
        "anyOf": [
          {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0
          },
          {
            "type": "null"
          }
        ],
        "title": "Rooms"
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "id",
      "kind",
      "resource_id",
      "title",
      "start",
      "end"
    ],
    "title": "PlanItem"
  },
  "CostLine": {
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Id"
      },
      "item_id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Item Id"
      },
      "amount_cents": {
        "anyOf": [
          {
            "type": "integer",
            "maximum": 1000000000000.0,
            "minimum": 0.0
          },
          {
            "type": "null"
          }
        ],
        "title": "Amount Cents"
      },
      "category": {
        "type": "string",
        "enum": [
          "quote",
          "estimate",
          "unknown"
        ],
        "title": "Category"
      },
      "unknown_reason": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "title": "Unknown Reason"
      },
      "query": {
        "$ref": "#/components/schemas/PriceQuery"
      },
      "evidence_id": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          {
            "type": "null"
          }
        ],
        "title": "Evidence Id"
      },
      "is_mock": {
        "type": "boolean",
        "title": "Is Mock"
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "id",
      "item_id",
      "amount_cents",
      "category",
      "unknown_reason",
      "query",
      "evidence_id",
      "is_mock"
    ],
    "title": "CostLine"
  },
  "PriceQuery": {
    "properties": {
      "resource_id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Resource Id"
      },
      "start_date": {
        "type": "string",
        "format": "date",
        "title": "Start Date"
      },
      "end_date": {
        "type": "string",
        "format": "date",
        "title": "End Date"
      },
      "currency": {
        "type": "string",
        "const": "CNY",
        "title": "Currency"
      },
      "room_type": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          },
          {
            "type": "null"
          }
        ],
        "title": "Room Type"
      },
      "rooms": {
        "anyOf": [
          {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0
          },
          {
            "type": "null"
          }
        ],
        "title": "Rooms"
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "resource_id",
      "start_date",
      "end_date",
      "currency",
      "room_type",
      "rooms"
    ],
    "title": "PriceQuery",
    "description": "Exact scope of an already expanded CNY total; no room/night arithmetic."
  },
  "ItemConfirmation": {
    "properties": {
      "item_id": {
        "type": "string",
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "title": "Item Id"
      },
      "item_hash": {
        "type": "string",
        "title": "Item Hash"
      }
    },
    "additionalProperties": false,
    "type": "object",
    "required": [
      "item_id",
      "item_hash"
    ],
    "title": "ItemConfirmation"
  }
}